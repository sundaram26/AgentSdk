{
  "name": "@arclet/core",
  "version": "1.0.1",
  "description": "Deterministic TypeScript AI agent runtime with Ports & Adapters, finite state machine, multi-tier memory, and guardrails",
  "homepage": "https://arclet.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundaram26/AgentSdk.git",
    "directory": "packages/agent-sdk"
  },
  "bugs": {
    "url": "https://github.com/sundaram26/AgentSdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "audit:types": "tsx scripts/audit-types.ts",
    "test": "vitest run"
  },
  "keywords": [
    "arclet",
    "ai",
    "agent",
    "ai-agent",
    "agentic-ai",
    "llm",
    "llm-framework",
    "typescript-agent",
    "state-machine",
    "guardrails",
    "memory",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "deterministic-ai",
    "langchain-alternative"
  ],
  "license": "ISC",
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "openai": "^7.3.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^26.1.2",
    "openai": "^7.3.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5",
    "zod": "^4.4.3"
  }
}