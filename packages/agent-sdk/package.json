{
  "name": "@weave-agent/core",
  "version": "1.0.1",
  "description": "TypeScript-native AI Agent SDK with Ports & Adapters, State Machine, Memory, and Guardrails",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "audit:types": "tsx scripts/audit-types.ts",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "state-machine",
    "guardrails",
    "memory"
  ],
  "license": "ISC",
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "openai": "^7.3.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^26.1.2",
    "openai": "^7.3.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5",
    "zod": "^4.4.3"
  }
}