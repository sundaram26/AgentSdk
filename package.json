{
  "name": "agent-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm --filter arclet build",
    "typecheck": "pnpm --filter arclet typecheck",
    "audit:types": "pnpm --filter arclet audit:types",
    "test": "pnpm --filter arclet test",
    "dev": "pnpm -r --parallel run dev",
    "dev:docs": "pnpm --filter arclet-docs dev",
    "build:docs": "pnpm --filter arclet-docs build",
    "dev:landing": "pnpm --filter landing dev",
    "build:landing": "pnpm --filter landing build",
    "start:landing": "pnpm --filter landing start"
  },
  "devDependencies": {
    "pnpm": "^10.16.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}